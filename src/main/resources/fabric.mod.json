      "com.hakimen.kawaiidishes.integration.emi.EMIPlugin"
    ],
    "fabric-datagen": [
      "com.hakimen.kawaiidishes.datagen.DataGeneration"
    ],
    "client": [
      "com.hakimen.kawaiidishes.client.KawaiiDishesClient"
    ],
    "main": [
      "com.hakimen.kawaiidishes.KawaiiDishes"
    ]
  },
  "mixins": [
