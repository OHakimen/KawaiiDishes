{
  "schemaVersion": 1,
  "id": "kawaiidishes",
  "version": "${version}",
  "name": "Kawaii Dishes",
  "description": "A mod about coffee, food and maids",
  "authors": [
    "Hakimen"
  ],
  "contact": {

  },
  "license": "MIT",
  "icon": "assets/kawaiidishes/icon.png",
  "environment": "*",
  "entrypoints": {
